# Copy to .env, chmod 600. Never commit .env. Never paste these into Claude.
# Agents NEVER see this file: each phase gets only the keys listed in
# READ_ENV_KEYS / IMPLEMENTER_ENV_KEYS / WRITE_ENV_KEYS below.

# ── Slack (from the app you created with slack-manifest.yaml) ──────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
BOT_CHANNEL_ID=C0123456789        # the one channel the bot works in
BOT_USER_ID=U0123456789           # the bot's own user id (botctl/doctor prints it)
OWNER_USER_ID=U0123456789         # you; named in "ask <owner>" replies
WRITE_ALLOWED_USER_IDS=U0123456789  # comma list; may direct-push and change live data
# ADDRESS_AS={"U0123456789": "boss"}  # optional nicknames, JSON

# ── Repository ─────────────────────────────────────────────────────────────
REPO_SLUG=your-org/your-repo
# REPO_PATH=./repo                # canonical checkout (default: ./repo)
DEFAULT_BRANCH=main
# Run once in every fresh worktree so tests can run:
# SETUP_COMMAND=pnpm install --frozen-lockfile --prefer-offline
# SETUP_COMMAND=python -m venv .venv && .venv/bin/pip install -e '.[dev]'

# ── Models (aliases or full ids) ───────────────────────────────────────────
TRIAGE_MODEL=sonnet
PLAN_MODEL=opus
IMPLEMENTER_MODEL=opus
# PROGRESS_MODEL=haiku            # fresh progress lines; empty = canned pool

# ── Behaviour ──────────────────────────────────────────────────────────────
BOT_WORKERS=2
BOT_FORCE_PR=true                 # start with every code change as a PR; turn off once trusted
BOT_OPEN_ISSUES=true
BOT_DRY_RUN=false                 # true = log matching messages and do nothing else
# PROGRESS_INTERVAL_SECONDS=600
# IMPLEMENTER_TIMEOUT_SECONDS=10800

# ── What agents may see (names of keys in THIS file) ───────────────────────
# READ_ENV_KEYS=DB_READ_URL       # read-only creds: every phase
# IMPLEMENTER_ENV_KEYS=NEXT_PUBLIC_SITE_URL   # extra build/test vars: implementer
# WRITE_ENV_KEYS=DB_WRITE_URL     # only for an `action` by a write-allowed user
# DB_READ_URL=postgresql://readonly_user:...@host:5432/db

# ── Optional MCP servers ───────────────────────────────────────────────────
# MCP_CONFIG=/home/bot/slack-agent-bot/mcp.json   # outside the repo
# MCP_READ_TOOLS=mcp__myapi__search,mcp__myapi__get_item
# MCP_WRITE_TOOLS=mcp__myapi__update_item
